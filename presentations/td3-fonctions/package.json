{
  "name": "atelier-presentations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare:math": "node scripts/prepare-equations.mjs",
    "build:motion": "npm run prepare:math && vite build --config motion/vite.config.ts",
    "pretest": "npm run prepare:math",
    "premotion": "npm run prepare:math",
    "typecheck": "npm run prepare:math && tsc --noEmit",
    "build": "npm run typecheck && vite build --config motion/vite.config.ts && npm run docs && vite build",
    "test": "node scripts/test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "motion": "vite --config motion/vite.config.ts",
    "docs": "node scripts/export-docs.mjs",
    "format": "prettier --write src examples motion tests scripts vite.config.ts presentation.config.ts",
    "validate": "npm test && npm run build",
    "new:lesson": "node scripts/new-lesson.mjs"
  },
  "dependencies": {
    "@motion-canvas/core": "3.17.2",
    "@motion-canvas/2d": "3.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "katex": "0.19.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jsdom": "21.1.7",
    "@types/katex": "0.16.7",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.21.5",
    "jsdom": "25.0.1",
    "mathjax-full": "3.2.2",
    "nerdamer": "1.1.13",
    "parse-svg-path": "0.1.2",
    "prettier": "3.4.2",
    "typescript": "5.7.3",
    "vite": "5.4.21"
  },
  "description": "Reusable animated teaching presentations with React and Motion Canvas",
  "license": "MIT",
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
